[Unit]
Description=spark-console (GPU/CPU control panel for a DGX Spark)
After=network-online.target

[Service]
WorkingDirectory=%h/projects/spark-console
# Extra flags (for example --llm URL) come from SPARK_CONSOLE_ARGS in a drop-in; unset means none.
ExecStart=/usr/bin/python3 -m spark_console --bind unix:%t/spark-console/http.sock $SPARK_CONSOLE_ARGS
# Only this user (and root's tailscaled) can open the socket.
RuntimeDirectory=spark-console
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=3
# SIGTERM makes the server revert an open trial before it exits.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
